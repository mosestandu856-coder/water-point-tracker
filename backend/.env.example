# Server configuration
PORT=5000

# MongoDB local connection
MONGODB_URI=mongodb://localhost:27017
DB_NAME=waterTracker

# Front-end origin allowed by CORS (change for production)
FRONTEND_ORIGIN=http://localhost:3000

# Authentication & Session Security (JWT & Cookies)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key
COOKIE_SECRET=replace_with_a_secure_random_cookie_signing_key
