# Environment Variables Template for Production Cloud Hosting
# Copy or set these in your cloud provider's dashboard (e.g. Render / Railway / Vercel)

# Node Environment
NODE_ENV=production

# Server Port (Render sets this automatically)
PORT=10000

# MongoDB Atlas Connection String (from https://cloud.mongodb.com)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/waterTracker?retryWrites=true&w=majority
DB_NAME=waterTracker

# Session Secrets
JWT_SECRET=super_secret_jwt_key_for_bugema_university_water_tracker_2026
COOKIE_SECRET=super_secret_cookie_signing_key_luweero_water_tracker_2026

# Demo Credentials
DEMO_PASSWORD=WaterTracker@2026
DEMO_MODE=true
